{
    "id": "child_and_intrusion_fusion",
    "graph": {
        "nodes": [
            {
                "id": "src1",
                "type": "file_source",
                "params": {
                "url": "file:///home/sevnce/project/video/test/child_on_wall.mp4",
                "loop": true,
                "realtime": true,
                "skip_frames": 1
                }
            },
            {
                "id": "decode1",
                "type": "ffmpeg_decode",
                "params": {
                    "output_bgr": true,
                    "hw_decoder": true
                }
            },
            {
                "id": "preprocess1",
                "type": "resize_normalize",
                "params": {
                    "output_width": 640,
                    "output_height": 640,
                    "keep_aspect_ratio": true
                }
            },
            {
                "id": "infer_yoloe",
                "type": "detection_infer",
                "params": {
                    "detector_config": {
                        "model_path": "/home/sevnce/project/ai_stream_pipeline/models/yoloe/yoloe_v8s_child_wall_gate.engine",
                        "conf_threshold": 0.25,
                        "nms_threshold": 0.4,
                        "input_size": {
                            "width": 640,
                            "height": 640
                        },
                        "batch_size": 1,
                        "model_class_names": [
                            "child",
                            "wall",
                            "gate"
                        ],
                        "cuda_graph": false
                    }
                }
            },
            {
                "id": "infer_yolov8",
                "type": "detection_infer",
                "params": {
                    "detector_config": {
                        "model_path": "/home/sevnce/project/ai_stream_pipeline/models/sevncevision/20260921_sevnce_9_cls_nms_trans_640.engine",
                        "conf_threshold": 0.3,
                        "nms_threshold": 0.45,
                        "input_size": {
                            "width": 640,
                            "height": 640
                        },
                        "batch_size": 1,
                        "model_class_names": [
                            "person",
                            "head",
                            "helmet",
                            "work_clothes",
                            "phone",
                            "smoking",
                            "fall_down",
                            "safety_belt",
                            "sleeping"
                        ],
                        "cuda_graph": false
                    }
                }
            },
            {
                "id": "fusion1",
                "type": "fusion",
                "params": {
                    "mode": "detection_merge",
                    "detection_sources": [
                        "infer_yoloe",
                        "infer_yolov8"
                    ],
                    "class_offsets": {
                        "infer_yolov8": 10
                    },
                    "wait_timeout_ms": 40,
                    "cross_nms": false,
                    "nms_iou_threshold": 0.5
