            },
            {
                "id": "rel1",
                "type": "relation_recognition",
                "params": {
                    "model_path": "/home/sevnce/project/ai_stream_pipeline/models/relateanything/relateanything.engine",
                    "predicate_bank": "/home/sevnce/project/ai_stream_pipeline/models/relateanything/predicate_bank.json",
                    "img_size": 448,
                    "max_boxes": 32,
                    "predicates": [
                        "beside",
                        "in front of",
                        "behind",
                        "on"
                    ],
                    "score_threshold": 0.1,
                    "box_confidence": 0.2,
                    "max_relations": 256,
                    "boundary_classes": [
                        "wall",
                        "gate"
                    ],
                    "backend": "auto"
                }
            },
            {
                "id": "alert1",
                "type": "alert",
                "params": {
                    "process_type": "parallel",
                    "rules": [
                        {
                            "type": "child_near_boundary",
                            "params": {
                                "name": "child_near_wall",
                                "rule_zones": [],
                                "child_class": "child",
                                "boundary_classes": [
                                    "wall",
                                    "gate"
                                ],
                                "relation_threshold": 0.15,
                                "geometric_fallback": false,
                                "max_pixel_gap": 60,
                                "duration_ms": 1000,
                                "max_disappear_count": 30
                            }
                        },
                        {
                            "type": "person_intrusion",
                            "params": {
                                "name": "person_intrusion",
                                "rule_zones": []
                            }
                        }
                    ]
                }
            },
            {
                "id": "evid1",
                "type": "evidence",
                "params": {
                    "video": {
                        "enabled": true,
                        "pre_frames": 20,
                        "post_frames": 40,
                        "fps": 25,
                        "encoder": "h264_nvenc",
                        "bitrate": 4000,
                        "output_dir": "./evidence/videos"
                    },
                    "snapshot": {
                        "enabled": true,
                        "output_dir": "./evidence/snapshots"
                    }
                }
            },
            {
                "id": "vlm1",
                "type": "vlm_gate",
                "params": {
                    "enabled": true,
                    "url": "http://8.137.122.254:21610/v1",
                    "api_key": "${VLM_API_KEY}",
                    "model": "qwen3.8-27b",
                    "enable_thinking": false,
                    "max_tokens": 512,
                    "timeout_ms": 15000,
                    "retries": 1,
                    "max_side": 1024,
                    "confidence_threshold": 0.6,
                    "cooldown_s": 30,
                    "unmatched_policy": "auto",
                    "review_dir": "./vlm_review",
                    "prompts": {
                        "child_near_wall": {
                            "question": "图中红框为儿童、蓝框为墙或大门。请判断：儿童是否处在墙或大门附近（在其旁边、贴近或倚靠，存在翻越/坠落风险即可，不要求正在攀爬）。只判真假，仅输出 {\"verdict\":true/false,\"confidence\":0.0-1.0,\"reason\":\"不超过20字\"}",
                            "confidence_threshold": 0.6
                        },
                        "person_intrusion": {
                            "question": "图中红框为人员。请判断：该人员是否确实进入了划定的禁区/入侵区域。只判真假，仅输出 {\"verdict\":true/false,\"confidence\":0.0-1.0,\"reason\":\"不超过20字\"}",
                            "confidence_threshold": 0.6
                        }
                    }
                }
            },
            {
                "id": "report1",
                "type": "report",
                "params": {
                    "enabled": true,
                    "url": "http://127.0.0.1:8902/alert",
                    "api_key": "",
                    "attach_image": true,
                    "image_field": "snapshot_base64",
                    "image_max_side": 0,
                    "timeout_ms": 3000,
                    "retries": 1,
                    "source": "ai_stream"
                }
            },
            {
                "id": "draw1",
                "type": "osd_draw",
                "params": {
