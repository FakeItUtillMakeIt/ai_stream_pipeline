# cmake/ai_stream_pipelineConfig.cmake.in
@PACKAGE_INIT@

# 自定义 Find 模块（FindFFmpeg/FindTensorRT）随包安装
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(spdlog)
find_dependency(nlohmann_json)
find_dependency(OpenCV COMPONENTS core imgproc videoio dnn)
find_dependency(FFmpeg COMPONENTS avcodec avformat avutil swscale)

if(@WITH_TRACK@)
    find_dependency(Eigen3)
endif()

if(@WITH_TENSORRT@)
    find_dependency(CUDAToolkit)
    find_dependency(TensorRT)
endif()

if(@WITH_CUDA@ AND NOT @WITH_TENSORRT@)
    find_dependency(CUDAToolkit)
endif()

if(@WITH_RKNN@)
    find_dependency(RKNN)
endif()

if(@WITH_ASCEND@)
    find_dependency(Ascend)
endif()

if(@WITH_FTP@)
    find_dependency(CURL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ai_stream_pipelineTargets.cmake")
check_required_components(ai_stream_pipeline)
