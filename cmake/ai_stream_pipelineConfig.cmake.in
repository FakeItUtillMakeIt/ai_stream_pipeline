# cmake/ai_stream_pipelineConfig.cmake.in
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(spdlog)
find_dependency(nlohmann_json)
find_dependency(OpenCV COMPONENTS core imgproc)
find_dependency(FFmpeg COMPONENTS avcodec avformat avutil swscale)

if(@WITH_TENSORRT@)
    find_dependency(TensorRT)
endif()
if(@WITH_ONNX@)
    find_dependency(ONNXRuntime)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ai_stream_pipelineTargets.cmake")
check_required_components(ai_stream_pipeline)